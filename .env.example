PORT=3000

# Issuer ID from the Google Wallet Business Console (console.pay.google.com)
GOOGLE_WALLET_ISSUER_ID=your_issuer_id_here

# Path to the JSON key file for the service account you added as an
# authorized user on the issuer account
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Business/brand name shown on the loyalty card (must match your Business
# Profile in the Wallet Console)
GOOGLE_WALLET_ISSUER_NAME=your_business_name_here

# Name of the loyalty program shown on the card
GOOGLE_WALLET_PROGRAM_NAME=Demo Rewards

# Publicly reachable HTTPS URL to a square logo image (recommended 660x660)
GOOGLE_WALLET_LOGO_URL=https://example.com/logo.png

# Origin of the site that calls this API (needed for CORS), e.g. https://www.example.com
CORS_ORIGIN=https://www.example.com
